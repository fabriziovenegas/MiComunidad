<?xml version="1.0" encoding="utf-8"?>
<!-- Center the complete artwork within the adaptive icon's circular safe
     zone. Relative padding scales with launcher bounds; no external ring. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="25%"
    android:insetTop="25%"
    android:insetRight="25%"
    android:insetBottom="25%">
    <bitmap
        android:src="@drawable/launcher_logo"
        android:gravity="fill"
        android:filter="true" />
</inset>
